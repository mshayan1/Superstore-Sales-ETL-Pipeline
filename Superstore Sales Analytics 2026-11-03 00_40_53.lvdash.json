{
  "datasets": [
    {
      "name": "superstore_orders",
      "displayName": "Superstore Orders",
      "queryLines": [
        "SELECT\n",
        "  Order_ID,\n",
        "  Order_Date,\n",
        "  Category,\n",
        "  Region,\n",
        "  Product_Name,\n",
        "  Sales,\n",
        "  Profit\n",
        "FROM\n",
        "  superstore_cleaned"
      ],
      "columns": [
        {
          "displayName": "Profit Margin %",
          "description": "Overall profit margin: total profit divided by total sales, as a percentage.",
          "expression": "SUM(Profit) / SUM(Sales) * 100"
        }
      ],
      "catalog": "dbacademy",
      "schema": "default"
    },
    {
      "name": "top_products",
      "displayName": "Top 10 Products by Sales",
      "queryLines": [
        "SELECT\n",
        "  Product_Name,\n",
        "  ROUND(SUM(Sales), 2) AS Total_Sales,\n",
        "  ROUND(SUM(Profit), 2) AS Total_Profit,\n",
        "  SUM(Quantity) AS Units_Sold\n",
        "FROM\n",
        "  superstore_cleaned\n",
        "GROUP BY\n",
        "  Product_Name\n",
        "ORDER BY\n",
        "  Total_Sales DESC\n",
        "LIMIT 10"
      ],
      "catalog": "dbacademy",
      "schema": "default"
    }
  ],
